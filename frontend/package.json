{
  "name": "edizora-panel",
  "version": "0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:api && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run check:api && tsc --noEmit",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/generated/api.ts",
    "check:api": "node scripts/check-api.mjs",
    "test:client": "node --experimental-strip-types --test scripts/test-client.mjs scripts/test-i18n.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
