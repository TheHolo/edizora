[Unit]
Description=Edizora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edizora
WorkingDirectory=/opt/edizora
ExecStart=/opt/edizora/.venv/bin/python -m app.main
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
