BOT_TOKEN=
ADMIN_IDS=123456789
DATABASE_URL=sqlite+aiosqlite:///./data/database.db
DEFAULT_CHANNEL_ALIAS=artwork
# Keep JSON on one line and wrap it in single quotes.
# Example: '{"artwork":{"chat_id":"-1001234567890","title":"Artwork","publish_mode":"auto"}}'
CHANNELS_JSON='{}'
HTTP_PROXY=
SOCKS_PROXY=
PIXIV_COOKIES=
NEWS_WORKER_TOKEN=

# Local mode (python -m app.local): the bot and worker run together.
# Optional initial model. Select and save via /models in Telegram or:
# python -m app.local --models
# python -m app.local --select-model "model-id"
# storage/lmstudio-model.json takes priority over this initial setting.
# Also used for English artwork-title translation; fallback is configured in [bot].
HOME_WORKER_LLM_PROVIDER=lmstudio
HOME_WORKER_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
HOME_WORKER_LMSTUDIO_MODEL=
# Only required if LM Studio Server Settings -> Require Authentication is enabled.
HOME_WORKER_LMSTUDIO_API_KEY=

# Separate VPS + home worker only. These tokens are automatic in local mode.
# Set HOME_WORKER_TOKEN to the same secret as NEWS_WORKER_TOKEN on the VPS.
HOME_WORKER_TOKEN=
HOME_WORKER_VPS_API_URL=http://127.0.0.1:8091
HOME_WORKER_OLLAMA_BASE_URL=http://127.0.0.1:11434
HOME_WORKER_OLLAMA_MODEL=gemma4:12b

# Managed web host. Keep active SQLite and control outside OneDrive/network shares.
# PUBLISHER_CONTROL_DIR=C:/Users/you/AppData/Local/Publisher/control
# PUBLISHER_DATA_ROOT=C:/Users/you/AppData/Local/Publisher/data
# PUBLISHER_DATABASE_PATH=C:/Users/you/AppData/Local/Publisher/data/database.db
# PUBLISHER_ORIGIN=https://publisher.example.org
# PUBLISHER_PANEL_URL=https://publisher.example.org
# PUBLISHER_FRONTEND_DIR=C:/path/to/release/frontend/dist
# See docs/web-platform-quickstart.md before first activation or legacy import.
